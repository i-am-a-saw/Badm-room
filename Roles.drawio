        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nskinparam shadowing false\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\nactor \&quot;Гость\&quot; as Guest\nactor \&quot;Спортсмен\&quot; as Athlete\nactor \&quot;Тренер\&quot; as Coach\nactor \&quot;Администратор\&quot; as Admin\n\nrectangle \&quot;Мобильное приложение\\nдля записи на тренировки по бадминтону\&quot; {\n\n  package \&quot;Общие функции\&quot; {\n    usecase \&quot;Регистрация\&quot; as Register\n    usecase \&quot;Авторизация\&quot; as Login\n    usecase \&quot;Восстановление пароля\&quot; as Restore\n\n    usecase \&quot;Просмотр общего расписания тренировок\&quot; as Schedule\n    usecase \&quot;Просмотр тренировки\&quot; as LessonInfo\n    usecase \&quot;Просмотр тренеров\&quot; as Coaches\n    usecase \&quot;Фильтрация тренировок\&quot; as Filter\n  }\n\n  package \&quot;Функции пользователя\&quot; {\n    usecase \&quot;Редактирование профиля\&quot; as Profile\n    usecase \&quot;Запись на тренировку\&quot; as Book\n    usecase \&quot;Отмена записи\&quot; as CancelBook\n    usecase \&quot;Просмотр своих записей\&quot; as MyBookings\n    usecase \&quot;Просмотр истории посещений\&quot; as History\n    usecase \&quot;Просмотр уведомлений\&quot; as Notifications\n  }\n\n  package \&quot;Тренер\&quot; {\n    usecase \&quot;Просмотр недельного расписания для тренеров\&quot; as CoachWeekSchedule\n    usecase \&quot;Просмотр своих тренировок\&quot; as MyLessons\n    usecase \&quot;Просмотр участников\&quot; as Participants\n    usecase \&quot;Отметка посещаемости\&quot; as Attendance\n    usecase \&quot;Корректировка посещаемости\&quot; as CorrectAttendance\n    usecase \&quot;Просмотр статистики тренировок\&quot; as CoachStats\n  }\n\n  package \&quot;Администратор\&quot; {\n    usecase \&quot;Создание расписания тренировок с назначением залов\&quot; as CreatePublicSchedule\n    usecase \&quot;Создание расписания на неделю для тренеров\&quot; as CreateCoachWeekSchedule\n    usecase \&quot;Просмотр пользователей\&quot; as Users\n    usecase \&quot;Редактирование пользователя\&quot; as EditUser\n    usecase \&quot;Блокировка пользователя\&quot; as BlockUser\n    usecase \&quot;Разблокировка пользователя\&quot; as UnblockUser\n    usecase \&quot;Назначение роли\&quot; as AssignRole\n\n    usecase \&quot;Добавление тренера\&quot; as AddCoach\n    usecase \&quot;Редактирование тренера\&quot; as EditCoach\n    usecase \&quot;Удаление тренера\&quot; as DeleteCoach\n\n    usecase \&quot;Создание тренировки\&quot; as CreateLesson\n    usecase \&quot;Редактирование тренировки\&quot; as EditLesson\n    usecase \&quot;Перенос тренировки\&quot; as Reschedule\n    usecase \&quot;Отмена тренировки\&quot; as CancelLesson\n    usecase \&quot;Удаление тренировки\&quot; as DeleteLesson\n\n\n    usecase \&quot;Просмотр всех записей\&quot; as AllBookings\n    usecase \&quot;Создание записи спортсмена на тренировку\&quot; as ManualBooking\n    usecase \&quot;Отмена записи спортсмена на тренировку\&quot; as AdminCancelBooking\n\n    usecase \&quot;Корректировка посещаемости\&quot; as AdminAttendance\n    usecase \&quot;Отправка уведомлений\&quot; as SendNotifications\n    usecase \&quot;Просмотр общей статистики\&quot; as AdminStats\n  }\n}\n\n' ===== Гость =====\nGuest --&gt; Register\nGuest --&gt; Login\nGuest --&gt; Restore\nGuest --&gt; Schedule\nGuest --&gt; LessonInfo\nGuest --&gt; Coaches\n\n' ===== Спортсмен =====\nAthlete --&gt; Schedule\nAthlete --&gt; LessonInfo\nAthlete --&gt; Coaches\nAthlete --&gt; Filter\nAthlete --&gt; Profile\nAthlete --&gt; Book\nAthlete --&gt; CancelBook\nAthlete --&gt; MyBookings\nAthlete --&gt; History\nAthlete --&gt; Notifications\n\n' ===== Тренер =====\nCoach --&gt; Schedule\nCoach --&gt; LessonInfo\nCoach --&gt; Coaches\nCoach --&gt; MyLessons\nCoach --&gt; Participants\nCoach --&gt; Attendance\nCoach --&gt; CorrectAttendance\nCoach --&gt; CoachStats\nCoach --&gt; Notifications\n\n' ===== Администратор =====\nAdmin --&gt; Schedule\nAdmin --&gt; Users\nAdmin --&gt; EditUser\nAdmin --&gt; BlockUser\nAdmin --&gt; UnblockUser\nAdmin --&gt; AssignRole\n\nAdmin --&gt; AddCoach\nAdmin --&gt; EditCoach\nAdmin --&gt; DeleteCoach\n\nAdmin --&gt; CreateLesson\nAdmin --&gt; EditLesson\nAdmin --&gt; Reschedule\nAdmin --&gt; CancelLesson\nAdmin --&gt; DeleteLesson\n\n\nAdmin --&gt; AllBookings\nAdmin --&gt; ManualBooking\nAdmin --&gt; AdminCancelBooking\n\nAdmin --&gt; AdminAttendance\nAdmin --&gt; SendNotifications\nAdmin --&gt; AdminStats\n\nGuest --&gt; Filter\nGuest --&gt; Profile\nGuest --&gt; CancelBook\nGuest --&gt; MyBookings\nGuest --&gt; History\nGuest --&gt; Notifications\nAthlete --&gt; Register\nAthlete --&gt; Login\nAthlete --&gt; Restore\nCoach --&gt; CoachWeekSchedule\nAdmin --&gt; CreatePublicSchedule\nAdmin --&gt; CreateCoachWeekSchedule\n@enduml&quot;,&#10;  &quot;config&quot;: null&#10;}" id="9IPD6AoZ4ebD28hFmejC-135">
